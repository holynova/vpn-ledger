<Window x:Class="VpnLedger.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VpnLedger"
  Title="VPN 流量账本" Width="940" Height="620" MinWidth="584" MinHeight="432" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI, Microsoft YaHei UI" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border Background="{DynamicResource Muted}" CornerRadius="3" Margin="2,1" Opacity="0.48"/>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource Wash}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Box" CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TileButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="1"/><Setter Property="Foreground" Value="#FFFAED"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" ClipToBounds="True">
          <Viewbox Margin="8,4" StretchDirection="DownOnly" Stretch="Uniform"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="32" Height="32" Margin="0,0,8,0"><TextBlock Text="{Binding Symbol}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid>
            <TextBlock x:Name="TileName" Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Margin="14,0" Width="1" Background="{TemplateBinding Foreground}" Opacity=".40"/>
            <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TileAmount" Text="{Binding Amount}" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="{Binding Share}" FontSize="14"/></StackPanel>
          </StackPanel></Viewbox>
        </Border><ControlTemplate.Triggers><DataTrigger Binding="{Binding Leading}" Value="True"><Setter TargetName="TileName" Property="FontSize" Value="30"/><Setter TargetName="TileAmount" Property="FontSize" Value="46"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".94"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="11"/></Style>
    <Style x:Key="Field" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  </Window.Resources>
  <Grid>
  <Grid x:Name="Dashboard" Margin="14,0,14,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="4,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,6,0"/><TextBlock x:Name="Status" VerticalAlignment="Center" FontWeight="SemiBold"/><Button x:Name="Pause" Content="暂停" Click="PauseClick" Margin="8,0,0,0" Background="{DynamicResource Wash}"/></StackPanel>
        <Border Grid.Column="1" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Line}"><StackPanel Orientation="Horizontal"><Button x:Name="VpnMode" Content="VPN" Padding="18,4" Click="ModeClick"/><Button x:Name="GlobalMode" Content="全局" Padding="18,4" Click="ModeClick"/></StackPanel></Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="History" Content="历史" Click="HistoryClick"/><Button x:Name="Settings" Content="设置" Click="SettingsClick"/></StackPanel>
      </Grid></Border>
    <Grid Grid.Row="1" Margin="4,12,4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width=".8*"/><ColumnDefinition Width=".8*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="UsageLabel" Style="{StaticResource Caption}"/><Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Total" FontSize="40" FontWeight="SemiBold"/><TextBlock x:Name="Unit" VerticalAlignment="Bottom" Margin="4,0,0,7" FontSize="18"/></StackPanel></Viewbox></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="↓ 下载" Style="{StaticResource Caption}"/><TextBlock x:Name="Down" FontSize="19" FontWeight="SemiBold"/></StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="↑ 上传" Style="{StaticResource Caption}"/><TextBlock x:Name="Up" FontSize="19" FontWeight="SemiBold"/></StackPanel>
      <Grid Grid.Column="3"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><local:SpeedChart x:Name="Chart" MinHeight="28" MaxHeight="43"/>
        <DockPanel Grid.Row="1"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="1m" Tag="1" Padding="3,2" FontSize="10" Click="RangeClick"/><Button Content="5m" Tag="5" Padding="3,2" FontSize="10" Click="RangeClick"/><Button Content="15m" Tag="15" Padding="3,2" FontSize="10" x:Name="DefaultRange" Click="RangeClick" Background="{DynamicResource Selected}"/></StackPanel><TextBlock x:Name="Speed" VerticalAlignment="Center" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></DockPanel>
      </Grid></Grid>
    <Border x:Name="Notice" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Wash}" CornerRadius="4" Padding="8,4"><TextBlock x:Name="NoticeText" FontSize="12" TextWrapping="Wrap"/></Border>
    <DockPanel Grid.Row="3" Margin="3,2,2,6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SortTotal" Content="用量" Click="SortClick"/><Button x:Name="SortSpeed" Content="速率" Click="SortClick"/><Button x:Name="ViewSwitch" Click="ViewClick"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="SectionTitle" FontWeight="SemiBold"/><TextBlock x:Name="Count" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel>
    <Grid Grid.Row="4">
      <Grid x:Name="Tiles" ClipToBounds="True"/>
      <ScrollViewer x:Name="RankingView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="List" Margin="14,0">
        <ItemsControl.ItemTemplate><DataTemplate><Button Click="AppClick" HorizontalContentAlignment="Stretch" Padding="0" Foreground="{DynamicResource Ink}"><Border Padding="6,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" ToolTip="{Binding Data.Detail}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Height="28" Width="28" HorizontalAlignment="Left" CornerRadius="7" Background="{DynamicResource Wash}"><Grid><TextBlock Text="{Binding Data.Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><Image Source="{Binding Data.Icon}" Width="23" Height="23"/></Grid></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Data.Name}" TextTrimming="CharacterEllipsis" FontSize="14"/><Grid Height="3" Width="136" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" HorizontalAlignment="Left" Margin="0,5,0,0"><Border Background="{DynamicResource Line}" CornerRadius="2"/><Border HorizontalAlignment="Left" Width="{Binding Data.Bar}" Background="{DynamicResource Accent}" CornerRadius="2"/></Grid></StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Data.Amount}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
          </Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl></ScrollViewer>
      <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="EmptyText" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Style="{StaticResource Caption}" Margin="0,6"/></StackPanel>
    </Grid>
    <Border Grid.Row="5" x:Name="Drawer" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Wash}" Margin="0,10,0,0" Padding="12,6,12,10">
      <StackPanel><Border Width="32" Height="3" Background="{DynamicResource Muted}" Opacity=".56" CornerRadius="2" Margin="0,0,0,7"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width=".8*"/><ColumnDefinition Width=".9*"/><ColumnDefinition Width=".8*"/><ColumnDefinition Width=".8*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="选中应用" Style="{StaticResource Caption}"/><TextBlock x:Name="DrawerName" Style="{StaticResource Field}"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="6,0"><TextBlock x:Name="TargetLabel" Style="{StaticResource Caption}"/><TextBlock x:Name="TargetValue" Style="{StaticResource Field}"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock x:Name="MetaLabel" Style="{StaticResource Caption}"/><TextBlock x:Name="MetaValue" Style="{StaticResource Field}"/></StackPanel>
          <StackPanel Grid.Column="3"><TextBlock x:Name="WhenLabel" Style="{StaticResource Caption}"/><TextBlock x:Name="WhenValue" Style="{StaticResource Field}"/></StackPanel>
          <StackPanel Grid.Column="4"><TextBlock Text="↓ 下载" Style="{StaticResource Caption}"/><TextBlock x:Name="DrawerDown" Style="{StaticResource Field}"/></StackPanel>
          <StackPanel Grid.Column="5"><TextBlock Text="↑ 上传" Style="{StaticResource Caption}"/><TextBlock x:Name="DrawerUp" Style="{StaticResource Field}"/></StackPanel>
          <Button x:Name="Details" Grid.Column="6" Content="详情 ›" VerticalAlignment="Center" Click="DetailsClick"/>
        </Grid></StackPanel></Border>
  </Grid>
  <Grid x:Name="Page" Visibility="Collapsed" Background="{DynamicResource Surface}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,12"><Grid>
      <Button x:Name="Back" Content="‹ 返回" Click="BackClick" HorizontalAlignment="Left" AutomationProperties.Name="返回"/>
      <TextBlock x:Name="PageTitle" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Button x:Name="RefreshPage" Content="刷新" Click="RefreshClick" HorizontalAlignment="Right"/>
    </Grid></Border>
    <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageContent" Margin="20,12,20,18"/></ScrollViewer>
  </Grid>
  </Grid>
</Window>
