<Window x:Class="VpnLedger.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VpnLedger"
  Title="VPN 流量账本" Width="446" Height="704" MinWidth="386" MinHeight="590" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI, Microsoft YaHei UI" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border Background="{DynamicResource Muted}" CornerRadius="3" Margin="2,1" Opacity="0.48"/>
          </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource Wash}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Box" CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
  <Grid x:Name="Dashboard">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="20,16,20,0">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal"><Border Background="{DynamicResource Tint}" CornerRadius="6" Width="25" Height="25"><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="15"/></Border><TextBlock Text="VPN 账本" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="16"/><Border CornerRadius="6" Background="{DynamicResource Wash}" Margin="12,0,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="VpnMode" Content="VPN" Click="ModeClick" ToolTip="仅统计已确认的代理连接"/><Button x:Name="GlobalMode" Content="全局" Click="ModeClick" ToolTip="统计本机物理网络的全部流量"/></StackPanel></Border></StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource Muted}" Margin="0,0,6,0"/><TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" Text="正在连接" FontSize="12"/></StackPanel>
      </DockPanel>
      <Grid Margin="0,22,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="UsageLabel" Text="今日代理用量" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="Total" Text="0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="38" FontWeight="SemiBold"/><TextBlock x:Name="Unit" Text="B" VerticalAlignment="Bottom" Margin="5,0,0,7" Foreground="{DynamicResource Muted}" FontSize="14"/></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6">
          <TextBlock HorizontalAlignment="Right"><Run Text="↓ 下载  " Foreground="{DynamicResource Muted}"/><Run x:Name="Down" Text="0 B" FontWeight="SemiBold"/></TextBlock>
          <TextBlock HorizontalAlignment="Right" Margin="0,4,0,0"><Run Text="↑ 上传  " Foreground="{DynamicResource Muted}"/><Run x:Name="Up" Text="0 B" FontWeight="SemiBold"/></TextBlock>
        </StackPanel>
      </Grid>
      <Border x:Name="Notice" Visibility="Collapsed" Background="{DynamicResource Wash}" CornerRadius="5" Padding="9,6" Margin="0,6,0,2"><TextBlock x:Name="NoticeText" FontSize="12" TextWrapping="Wrap"/></Border>
    </StackPanel>
    <StackPanel Grid.Row="1" x:Name="ChartPanel" Margin="20,12,20,15">
      <DockPanel LastChildFill="False"><TextBlock VerticalAlignment="Center"><Run Text="传输速度  " Foreground="{DynamicResource Muted}"/><Run x:Name="Speed" Text="0 B/s" FontWeight="SemiBold"/></TextBlock>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="1m" Tag="1" Click="RangeClick"/><Button Content="5m" Tag="5" Click="RangeClick"/><Button Content="15m" Tag="15" Click="RangeClick" x:Name="DefaultRange" Background="{DynamicResource Selected}"/></StackPanel></DockPanel>
      <local:SpeedChart x:Name="Chart" Height="68" Margin="0,6,0,0"/>
      <DockPanel Margin="0,3,0,0"><TextBlock x:Name="TimeLabel" Text="−15 分钟" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="现在" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11"/></DockPanel>
    </StackPanel>
    <Border Grid.Row="2" BorderThickness="0,1" BorderBrush="{DynamicResource Line}" Padding="20,9"><DockPanel LastChildFill="False">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="应用排行" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="Count" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Background="{DynamicResource Wash}"><Button x:Name="SortTotal" Content="用量" Click="SortClick" Background="{DynamicResource Selected}"/><Button x:Name="SortSpeed" Content="速率" Click="SortClick"/></StackPanel>
    </DockPanel></Border>
    <Grid Grid.Row="3">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="List" Margin="14,0">
        <ItemsControl.ItemTemplate><DataTemplate><Button Click="AppClick" HorizontalContentAlignment="Stretch" Padding="0" Foreground="{DynamicResource Ink}"><Border Padding="6,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" ToolTip="{Binding Data.Detail}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Height="28" Width="28" HorizontalAlignment="Left" CornerRadius="7" Background="{DynamicResource Wash}"><Grid><TextBlock Text="{Binding Data.Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><Image Source="{Binding Data.Icon}" Width="23" Height="23"/></Grid></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Data.Name}" TextTrimming="CharacterEllipsis" FontSize="14"/><Grid Height="3" Width="136" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" HorizontalAlignment="Left" Margin="0,5,0,0"><Border Background="{DynamicResource Line}" CornerRadius="2"/><Border HorizontalAlignment="Left" Width="{Binding Data.Bar}" Background="{DynamicResource Accent}" CornerRadius="2"/></Grid></StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Data.Amount}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
          </Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl></ScrollViewer>
      <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="EmptyText" Text="等待代理流量" Margin="0,9,0,0" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="产生代理流量后，应用会显示在这里" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
    </Grid>
    <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="14,8"><DockPanel LastChildFill="False">
      <TextBlock x:Name="Source" Text="Clash Verge · 本机" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="6,0"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="History" Content="历史" Click="HistoryClick"/><Button x:Name="Pause" Content="暂停" Click="PauseClick"/><Button x:Name="Settings" Content="设置" Click="SettingsClick"/></StackPanel>
    </DockPanel></Border>
  </Grid>
  <Grid x:Name="Page" Visibility="Collapsed" Background="{DynamicResource Surface}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,12"><Grid>
      <Button x:Name="Back" Content="‹ 返回" Click="BackClick" HorizontalAlignment="Left" AutomationProperties.Name="返回"/>
      <TextBlock x:Name="PageTitle" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Button x:Name="RefreshPage" Content="刷新" Click="RefreshClick" HorizontalAlignment="Right"/>
    </Grid></Border>
    <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageContent" Margin="20,12,20,18"/></ScrollViewer>
  </Grid>
  </Grid>
</Window>
